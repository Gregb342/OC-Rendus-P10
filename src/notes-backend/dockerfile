# Étape 1 : Build de l'application
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copie du fichier .csproj et restauration des dépendances
COPY ["notes-backend.csproj", "./"]
RUN dotnet restore "notes-backend.csproj"

# Copie du reste du code source
COPY . .

# Build de l'application
RUN dotnet build "notes-backend.csproj" -c Release -o /app/build

# Publication de l'application
FROM build AS publish
RUN dotnet publish "notes-backend.csproj" -c Release -o /app/publish

# Étape 2 : Image finale pour l'exécution
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
WORKDIR /app

# Copie des fichiers publiés depuis l'étape précédente
COPY --from=publish /app/publish .

# Exposition du port 8080
EXPOSE 8080

# Point d'entrée de l'application
ENTRYPOINT ["dotnet", "notes-backend.dll"]