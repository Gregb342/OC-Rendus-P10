@page "/patients/details/{Id:int}"
@rendermode InteractiveServer
@* @using Microsoft.AspNetCore.Authorization
@attribute [Authorize] *@
@using Patients_Frontend.Components.Notes
@using Patients_Frontend.DTOs

<PageTitle>Détails du patient</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">Détails du patient</h3>
                    <button class="btn btn-secondary" @onclick="RetourListe">
                        <i class="bi bi-arrow-left"></i> Retour
                    </button>
                </div>
                <div class="card-body">
                    @if (IsLoading)
                    {
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Chargement...</span>
                            </div>
                        </div>
                    }
                    else if (ErrorMessage != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            @ErrorMessage
                        </div>
                    }
                    else if (Patient != null)
                    {
                        <div class="row">
                            <div class="col-md-6">
                                <h5>Informations personnelles</h5>
                                <table class="table table-borderless">
                                    <tbody>
                                        <tr>
                                            <th scope="row" class="text-muted">Nom :</th>
                                            <td>@Patient.FirstName</td>
                                        </tr>
                                        <tr>
                                            <th scope="row" class="text-muted">Prénom :</th>
                                            <td>@Patient.LastName</td>
                                        </tr>
                                        <tr>
                                            <th scope="row" class="text-muted">Date de naissance :</th>
                                            <td>@Patient.DateOfBirth.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                        <tr>
                                            <th scope="row" class="text-muted">Âge :</th>
                                            <td>@CalculerAge() ans</td>
                                        </tr>
                                        <tr>
                                            <th scope="row" class="text-muted">Sexe :</th>
                                            <td>@Patient.Gender</td>
                                        </tr>
                                        <tr>
                                            <th scope="row" class="text-muted">Téléphone :</th>
                                            <td>@(string.IsNullOrEmpty(Patient.PhoneNumber) ? "Non renseigné" : Patient.PhoneNumber)</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <h5>Adresse</h5>
                                @if (Patient.Address != null)
                                {
                                    <table class="table table-borderless">
                                        <tbody>
                                            <tr>
                                                <th scope="row" class="text-muted">Rue :</th>
                                                <td>@Patient.Address.Street</td>
                                            </tr>
                                            <tr>
                                                <th scope="row" class="text-muted">Ville :</th>
                                                <td>@Patient.Address.City</td>
                                            </tr>
                                            <tr>
                                                <th scope="row" class="text-muted">Code postal :</th>
                                                <td>@Patient.Address.PostalCode</td>
                                            </tr>
                                            <tr>
                                                <th scope="row" class="text-muted">Pays :</th>
                                                <td>@Patient.Address.Country</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <p class="text-muted">Aucune adresse renseignée</p>
                                }
                            </div>
                        </div>
                        <div class="mt-4">
                            <button class="btn btn-primary me-2" @onclick="EditerPatient">
                                <i class="bi bi-pencil"></i> Éditer
                            </button>
                            <button class="btn btn-danger" @onclick="SupprimerPatient">
                                <i class="bi bi-trash"></i> Supprimer
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Section Évaluation du risque de diabète *@
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0"><i class="bi bi-activity"></i> Évaluation du risque de diabète</h4>
                </div>
                <div class="card-body">
                    @if (IsLoadingAssessment)
                    {
                        <div class="text-center">
                            <div class="spinner-border text-primary spinner-border-sm" role="status">
                                <span class="visually-hidden">Chargement...</span>
                            </div>
                            <span class="ms-2">Calcul du risque en cours...</span>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(AssessmentErrorMessage))
                    {
                        <div class="alert alert-warning" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> @AssessmentErrorMessage
                        </div>
                    }
                    else if (Assessment != null)
                    {
                        <div class="row">
                            <div class="col-md-6">
                                <h5>Niveau de risque</h5>
                                <div class="alert alert-@GetRiskLevelClass() d-flex align-items-center" role="alert">
                                    <i class="bi bi-shield-@(Assessment.RiskLevel == RiskLevel.None ? "check" : "exclamation") fs-3 me-3"></i>
                                    <div>
                                        <h4 class="mb-0">@GetRiskLevelText()</h4>
                                        <small>Évalué le @Assessment.AssessedAt.ToString("dd/MM/yyyy à HH:mm")</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h5>Détails de l'évaluation</h5>
                                <p><strong>Nombre de déclencheurs :</strong> @Assessment.TriggerCount</p>
                                @if (Assessment.MatchedTrigers.Any())
                                {
                                    <p><strong>Déclencheurs détectés :</strong></p>
                                    <ul class="list-unstyled">
                                        @foreach (var trigger in Assessment.MatchedTrigers)
                                        {
                                            <li><i class="bi bi-check-circle text-danger"></i> @trigger</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="text-muted">Aucun déclencheur détecté</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Section Notes *@
    <div class="row mt-4">
        <div class="col-md-12"> 
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0"><i class="bi bi-journal-text"></i> Historique des notes du patient</h4>
                </div>
                <div class="card-body">
                    <button class="btn btn-sm btn-success mb-3" @onclick="AjouterNote">
                        <i class="bi bi-plus-lg"></i> Ajouter une note
                    </button>
                    @if (!string.IsNullOrEmpty(NoteErrorMessage))
                    {
                        <div class="alert alert-info">
                            @NoteErrorMessage
                        </div>
                    } 
                    else if (noteList is null)
                    { 
                        <p class="text-muted">Chargement des notes...</p>
                    }
                    else if (!noteList.Any())
                    {
                        <p class="text-muted">Aucune note pour ce patient.</p>
                    }
                    else
                    {
                        @foreach (var note in noteList.OrderByDescending(n => n.CreatedAt))
                        {
                            <NoteItem Note="note" />
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
